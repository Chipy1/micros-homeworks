# Parameters
export REDIS_IMAGE=${REDIS_IMAGE:-redis:7.2.4}

# Master nodes (3 shards)
export REDIS_MASTER_01_PORT=7001
export REDIS_MASTER_02_PORT=7002
export REDIS_MASTER_03_PORT=7003
export REDIS_MASTER_01_HOST=redis-master-01
export REDIS_MASTER_02_HOST=redis-master-02
export REDIS_MASTER_03_HOST=redis-master-03

# Replica nodes (3 replicas, one per shard)
export REDIS_REPLICA_01_PORT=7004
export REDIS_REPLICA_02_PORT=7005
export REDIS_REPLICA_03_PORT=7006
export REDIS_REPLICA_01_HOST=redis-replica-01
export REDIS_REPLICA_02_HOST=redis-replica-02
export REDIS_REPLICA_03_HOST=redis-replica-03